{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-small-slm-notes/model.schema.json",
  "title": "SLM model entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "params",
    "license",
    "context_len",
    "modality",
    "release_date",
    "url",
    "quick_facts",
    "quant_available"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "not": { "const": "unknown" },
      "description": "Real model name. Never 'unknown'."
    },
    "params": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "TOTAL parameters in billions. Drives size bucket. Never 'unknown'."
    },
    "active_params": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "OPTIONAL. Active params (B) for MoE models."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX id or license name. May be the literal 'unknown'."
    },
    "context_len": {
      "description": "Context window in tokens, or the literal 'unknown'.",
      "anyOf": [
        { "type": "integer", "minimum": 1 },
        { "const": "unknown" }
      ]
    },
    "modality": {
      "type": "string",
      "minLength": 1,
      "description": "e.g. 'text', 'text+vision'. May be 'unknown'."
    },
    "release_date": {
      "description": "ISO date (YYYY-MM-DD), or the literal 'unknown'.",
      "anyOf": [
        { "type": "string", "format": "date" },
        { "const": "unknown" }
      ]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "Real HF / repo URL. Never 'unknown'."
    },
    "quick_facts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Required. Objective one-liners about the model."
    },
    "my_experience": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Optional. Personal usage — projects/infra where this model is used."
    },
    "quant_available": {
      "type": "boolean",
      "description": "Whether quantized builds (GGUF/AWQ/etc.) exist."
    }
  }
}
